{
  "apiVersion":"v1", "kind":"List", "items":[
    {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":"grant-runtime","namespace":"grant-exposure-v020","labels":{"deployment.exposure.io/owner":"grant-exposure-v020"}},"data":{}},
    {"apiVersion":"v1","kind":"ConfigMap","metadata":{"name":"exposure-runtime","namespace":"grant-exposure-v020","labels":{"deployment.exposure.io/owner":"grant-exposure-v020"}},"data":{}},
    {
      "apiVersion":"apps/v1","kind":"StatefulSet",
      "metadata":{"name":"grant-exposure","namespace":"grant-exposure-v020","labels":{"deployment.exposure.io/owner":"grant-exposure-v020"}},
      "spec":{
        "replicas":1,"serviceName":"grant","updateStrategy":{"type":"OnDelete"},
        "selector":{"matchLabels":{"app.kubernetes.io/name":"grant-exposure"}},
        "template":{
          "metadata":{"labels":{"app.kubernetes.io/name":"grant-exposure","deployment.exposure.io/owner":"grant-exposure-v020"}},
          "spec":{
            "serviceAccountName":"grant-exposure","automountServiceAccountToken":false,
            "nodeSelector":{"kubernetes.io/arch":"amd64"},
            "securityContext":{"runAsNonRoot":true,"runAsUser":10001,"runAsGroup":10001,"fsGroup":10001,"fsGroupChangePolicy":"OnRootMismatch","seccompProfile":{"type":"RuntimeDefault"}},
            "terminationGracePeriodSeconds":60,
            "volumes":[{"name":"state","persistentVolumeClaim":{"claimName":"grant-state"}},{"name":"grant-tmp","emptyDir":{"sizeLimit":"64Mi"}},{"name":"exposure-tmp","emptyDir":{"sizeLimit":"64Mi"}},{"name":"goauthy-ca","configMap":{"name":"goauthy-trust"}}],
            "containers":[
              {
                "name":"grant","image":"REQUIRED_RELEASED_GRANT_IMAGE",
                "imagePullPolicy":"IfNotPresent",
                "envFrom":[{"configMapRef":{"name":"grant-runtime"}}],
                "env":[
                  {"name":"GRANT_MASTER_KEY","valueFrom":{"secretKeyRef":{"name":"runtime-credentials","key":"master"}}},
                  {"name":"GRANT_APP_AUTH_KEY","valueFrom":{"secretKeyRef":{"name":"runtime-credentials","key":"app"}}},
                  {"name":"GRANT_GOAUTHY_INTROSPECTION_CLIENT_SECRET","valueFrom":{"secretKeyRef":{"name":"runtime-credentials","key":"goauthy-introspection"}}}
                ],
                "ports":[{"name":"grant","containerPort":8080}],
                "volumeMounts":[{"name":"state","mountPath":"/data"},{"name":"grant-tmp","mountPath":"/tmp"},{"name":"goauthy-ca","mountPath":"/etc/grant-goauthy","readOnly":true}],
                "securityContext":{"allowPrivilegeEscalation":false,"readOnlyRootFilesystem":true,"capabilities":{"drop":["ALL"]}},
                "resources":{"requests":{"cpu":"250m","memory":"512Mi"},"limits":{"cpu":"1","memory":"1Gi"}},
                "startupProbe":{"httpGet":{"path":"/healthz","port":"grant"},"periodSeconds":5,"failureThreshold":120},
                "livenessProbe":{"httpGet":{"path":"/healthz","port":"grant"},"periodSeconds":10},
                "readinessProbe":{"httpGet":{"path":"/readyz","port":"grant"},"periodSeconds":5}
              },
              {
                "name":"exposure","image":"ghcr.io/mrchypark/exposure@sha256:268d5ded6ec941af266306cf63f09c32a0ec38057b95f6c5ceb140afb04cce62",
                "imagePullPolicy":"IfNotPresent",
                "envFrom":[{"configMapRef":{"name":"exposure-runtime"}}],
                "env":[
                  {"name":"EXPOSURE_GRANT_APP_AUTH_KEY","valueFrom":{"secretKeyRef":{"name":"runtime-credentials","key":"app"}}},
                  {"name":"EXPOSURE_AUTHN_LIMITER_KEY","valueFrom":{"secretKeyRef":{"name":"runtime-credentials","key":"limiter"}}}
                ],
                "ports":[{"name":"exposure","containerPort":8082},{"name":"exposure-admin","containerPort":8083}],
                "volumeMounts":[{"name":"exposure-tmp","mountPath":"/tmp"}],
                "securityContext":{"allowPrivilegeEscalation":false,"readOnlyRootFilesystem":true,"capabilities":{"drop":["ALL"]}},
                "resources":{"requests":{"cpu":"50m","memory":"64Mi"},"limits":{"cpu":"250m","memory":"256Mi"}},
                "startupProbe":{"httpGet":{"path":"/healthz","port":"exposure-admin"},"periodSeconds":5,"failureThreshold":60},
                "livenessProbe":{"httpGet":{"path":"/healthz","port":"exposure-admin"},"periodSeconds":10},
                "readinessProbe":{"httpGet":{"path":"/readyz","port":"exposure-admin"},"periodSeconds":5}
              }
            ]
          }
        }
      }
    }
  ]
}
