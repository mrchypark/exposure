# Deployment template, not credentials or a ready-to-run environment.
# Register a provider/PEP and a reviewed public_authn catalog in Grant first.
EXPOSURE_PROXY_ENABLED=true
EXPOSURE_GRANT_LEARNER_URL=http://grant.example.svc.cluster.local:8080
EXPOSURE_PROVIDER_ID=example-auth
EXPOSURE_PEP_CLIENT_ID=example-auth-pep
EXPOSURE_PROVIDER_ORIGIN=http://identity.example.svc.cluster.local:8097
EXPOSURE_EXPECTED_CATALOG_DIGEST=__REQUIRED_REVIEWED_CATALOG_DIGEST__
EXPOSURE_GRANT_APP_AUTH_KEY=__REQUIRED_SECRET__
EXPOSURE_AUTHN_LIMITER_KEY=__REQUIRED_SECRET__
EXPOSURE_PROVIDER_AUTHORIZATION_MODE=forward-user
EXPOSURE_DATA_ADDR=:8082
EXPOSURE_ADMIN_ADDR=:8080
# Do not set a provider token for this auth instance.
# public_authn needs no user credential mode to issue an upstream token.
# If the same provider exposes authorized routes, configure its actual token
# format using EXPOSURE_CREDENTIAL_MODE and the corresponding issuer/app fields.
# A service-token data provider must run in a separate instance/catalog.
# Optional Goauthy user-only profile: set BOTH to reviewed distinct metadata.
# EXPOSURE_GOAUTHY_USER_CLIENT_ID=fixture-client
# EXPOSURE_GOAUTHY_USER_RESOURCE_AUDIENCE=https://resource.example
# This requires JWT aud=[client,resource], azp=client and the configured issuer;
# Grant online authentication remains authoritative. Unset both for strict-single.
